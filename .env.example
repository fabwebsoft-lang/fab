# ==============================================================================
# FabricCare - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your production/development credentials.

# Node Environment & Server Port
NODE_ENV=development
PORT=5000

# Secret Key for Signing JWT Sessions (Generate a random 32+ char string)
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# ------------------------------------------------------------------------------
# 1. Database Configuration (TiDB Serverless / MySQL 8.0)
# ------------------------------------------------------------------------------
# Example: mysql://user:password@gateway01.ap-south-1.prod.aws.tidbcloud.com:4000/fabric_care?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://root:password@localhost:3306/fabric_care

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5000/auth/google/callback (or https://yourdomain.com/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage Credentials
# ------------------------------------------------------------------------------
# Create bucket and API tokens at https://dash.cloudflare.com/ -> R2
# Account ID can be found on Cloudflare R2 Dashboard overview
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=fabric-care-storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
